DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Email via Resend API (solo necesario en producción / cuando DEBUG=False)
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=

# Remitente por defecto.
# Usar onboarding@resend.dev para pruebas sin dominio verificado.
# Cambiar por noreply@tudominio.com cuando verifiques el dominio en Resend.
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Mapas y Geolocalización (Leaflet.js + CARTO Basemaps + Nominatim)
# ---------------------------------------------------------------------------
# Clave de API de CARTO para cargar teselas cartográficas oficiales sin marca de agua.
# Obtenela en: https://carto.com/basemaps/apikey/
# Colocá tu clave real aquí para desarrollo local, y en las variables de entorno de Render para producción.
CARTO_API_KEY=tu_api_key_de_carto_aqui
