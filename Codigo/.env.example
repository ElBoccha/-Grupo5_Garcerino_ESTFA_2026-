DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Configuración de Email via Brevo SMTP
# ---------------------------------------------------------------------------
# Servidor y puerto SMTP de Brevo (por defecto: smtp-relay.brevo.com y 587)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587

# Credenciales SMTP de Brevo (obtener en: https://app.brevo.com/settings/keys/smtp)
BREVO_SMTP_USERNAME=tu_usuario_o_email_smtp_brevo
BREVO_SMTP_PASSWORD=tu_clave_smtp_brevo

# Remitente verificado en Brevo
DEFAULT_FROM_EMAIL=no-reply@tudominio.com

# ---------------------------------------------------------------------------
# Mapas y Geolocalización (Leaflet.js + CARTO Basemaps + Nominatim)
# ---------------------------------------------------------------------------
# Clave de API de CARTO para cargar teselas cartográficas oficiales sin marca de agua.
# Obtenela en: https://carto.com/basemaps/apikey/
# Colocá tu clave real aquí para desarrollo local, y en las variables de entorno de Render para producción.
CARTO_API_KEY=tu_api_key_de_carto_aqui
